#!/usr/bin/env bash
set -euo pipefail
# Runs after Casper's initramfs customization and before the display manager.
[[ -e /run/casper.log || -d /run/live || -d /cdrom/casper || $(findmnt -n -o FSTYPE /) == overlay ]] || exit 0
install -d /root/Desktop /root/Recovery /root/.config
rsync -a --ignore-existing /etc/skel/ /root/
printf 'PATH="/opt/recovery/custom:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n' > /etc/environment
cat > /etc/lightdm/lightdm.conf <<'EOF'
[Seat:*]
autologin-user=root
autologin-user-timeout=0
autologin-session=xfce
user-session=xfce
pam-autologin-service=recovery-autologin
greeter-hide-users=true
allow-guest=false
EOF
printf '[Desktop]\nSession=xfce\n' > /root/.dmrc
install -d -m 0700 /run/user/0
XDG_RUNTIME_DIR=/run/user/0 timeout 30 dbus-run-session -- recovery-trust-launchers /root/Desktop || true
