#!/usr/bin/env bash
set -u
# Thunar shows the untrusted-launcher dialog unless the file is executable and this checksum matches.
dir=${1:-$HOME/Desktop}
[[ -d $dir ]] || exit 0
while IFS= read -r -d '' launcher; do
  chmod 0755 "$launcher"
  gio set -t string "$launcher" metadata::xfce-exe-checksum "$(sha256sum "$launcher" | awk '{print $1}')" || true
done < <(find "$dir" -type f -name '*.desktop' -print0)
